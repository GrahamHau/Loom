PORT=3000
DATA_DIR=./data
SESSION_SECRET=change-this-long-random-string
APP_USERNAME=visitor
APP_PASSWORD=password
FEISHU_OAUTH_APP_ID=
FEISHU_OAUTH_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_OAUTH_AUTO_PROVISION=true
FEISHU_OAUTH_ALLOWED_TENANT_KEYS=
FEISHU_OAUTH_ALLOWED_EMAILS=
FEISHU_OAUTH_ALLOWED_OPEN_IDS=
FEISHU_OAUTH_ALLOWED_UNION_IDS=
LLM_TIMEOUT_MS=30000
RSS_COLLECT_ENABLED=true
RSS_COLLECT_INTERVAL_MS=900000
SEED_DEMO_DATA=false

# OpenAI-compatible LLM settings can be stored via the app settings page
# or supplied here in production. Keep real API keys out of Git.
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# Feishu settings are stored via the app settings page:
# - feishu_app_id
# - feishu_app_secret
# - feishu_base_token
# - feishu_products_table_id
# - feishu_demands_table_id
# - feishu_news_table_id
