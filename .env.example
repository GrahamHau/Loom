PORT=3000
DATA_DIR=./data
SESSION_SECRET=change-this-long-random-string
APP_USERNAME=change-this-user
APP_PASSWORD=change-this-password
APP_PASSWORD_ACCOUNTS=
LOOM_OWNER_EMAIL=
LOOM_OWNER_FEISHU_OPEN_ID=
LOOM_FEISHU_WORKSPACE_SLUG=company
LOOM_FEISHU_WORKSPACE_NAME=Company Workspace
LOOM_SEAL_CONFIG_DIR=
LOOM_ENABLE_PUBLIC_SAMPLE_DATA=true
FEISHU_OAUTH_APP_ID=
FEISHU_OAUTH_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_OAUTH_AUTO_PROVISION=true
FEISHU_OAUTH_ALLOWED_TENANT_KEYS=
FEISHU_OAUTH_ALLOWED_EMAILS=
FEISHU_OAUTH_ALLOWED_EMAIL_DOMAINS=
FEISHU_OAUTH_ALLOWED_OPEN_IDS=
FEISHU_OAUTH_ALLOWED_UNION_IDS=
LLM_TIMEOUT_MS=30000
RSS_COLLECT_ENABLED=true
RSS_COLLECT_INTERVAL_MS=900000
SEED_DEMO_DATA=false
RSSHUB_BASE_URL=
WECHAT_EXPORTER_BASE_URL=
WECHAT_EXPORTER_AUTH_KEY=
WECHAT_EXPORTER_MAX_PER_SOURCE=50
WECHAT_EXPORTER_ACCOUNTS_PATH=./data/wechat-exporter-accounts.json
WECHAT_EXPORTER_SOURCE_INTERVAL_MINUTES=1440
WECHAT_COLLECT_HOURS=9,21
WECHAT_COLLECT_TIMEZONE=Asia/Shanghai
WECHAT_CACHE_DAYS=10
STREAM_NEWS_MAX_AGE_DAYS=10
NEWS_RECENT_WINDOW_DAYS=5
SAMPLE_NEWS_MAX_AGE_HOURS=240
LOOM_REQUEST_LOG=false

# OpenAI-compatible LLM settings can be stored via the app settings page
# or supplied here in production. Keep real API keys out of Git.
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

