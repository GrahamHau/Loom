{
  "manifest_version": 3,
  "name": "LOOM Web Clipper",
  "version": "1.0.0",
  "description": "一键采集竞品和灵感到 LOOM 个人情报工作台",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LOOM Web Clipper"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.jp/*",
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.xiaohongshu.com/*",
        "*://www.xiaohongshu.com/*",
        "*://*.kickstarter.com/projects/*"
      ],
      "js": [
        "content/detector.js",
        "content/amazon.js",
        "content/taobao.js",
        "content/xiaohongshu.js",
        "content/kickstarter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "cookies"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.co.jp/*",
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.xiaohongshu.com/*",
    "*://www.xiaohongshu.com/*",
    "*://*.kickstarter.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://loom.palecedar.site/*",
    "https://loom.my1panelsite.xyz/*"
  ]
}
