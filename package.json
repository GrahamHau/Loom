{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:node": "node scripts/ensure-node-version.js",
    "dev": "npm run check:node && vite --host 127.0.0.1 --port 5173 --strictPort",
    "server:dev": "npm run check:node && NODE_ENV=development node server/index.js",
    "build": "npm run check:node && vite build",
    "start": "npm run check:node && NODE_ENV=production node server/index.js",
    "lint": "npm run check:node && eslint .",
    "typecheck": "npm run check:node && tsc --noEmit",
    "test": "npm run check:node && vitest run",
    "db:seed": "npm run check:node && node scripts/seed-db.js",
    "db:sync-sample": "npm run check:node && node scripts/sync-sample-workspace.js",
    "db:clear-demo": "npm run check:node && node scripts/clear-demo-state.js",
    "db:pull-remote": "npm run check:node && node scripts/pull-remote-db.js",
    "fields:normalize-tags": "npm run check:node && node scripts/normalize-field-tags.js",
    "stream:sync-official": "npm run check:node && node scripts/sync-official-stream-from-remote.js",
    "news:configure-sources": "npm run check:node && node scripts/configure-news-sources.js",
    "news:seed-sources": "npm run check:node && node scripts/seed-news-sources.js",
    "seal:apply": "npm run check:node && node scripts/apply-seal-config.js",
    "news:reclassify": "npm run check:node && node scripts/reclassify-news.js",
    "listen:loom": "npm run check:node && node scripts/loom-listener.js",
    "stream:sync-feedhub": "npm run check:node && node scripts/sync-feedhub-official-stream.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "better-sqlite3": "^12.5.0",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "nanoid": "^5.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
